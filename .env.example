# apps/api — local development environment
DATABASE_URL="postgresql://USER@localhost:5432/cms"
API_PORT=4000
JWT_SECRET="dev-only-change-me"
JWT_EXPIRES_IN="7d"
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"

# Telling the public website to forget a site's cached pages after a publish (CNT-08). Both empty: off,
# and the website then caches nothing either. The secret must match the website's REVALIDATE_SECRET.
WEB_REVALIDATE_URL=""
REVALIDATE_SECRET=""

# Uploaded pictures (MED-01, D-042). MEDIA_DIR is the folder they are stored in (default: uploads/ in this repo).
# MEDIA_PUBLIC_URL is the address browsers load them from: empty means http://localhost:<API_PORT>/uploads; live,
# the API's public address plus /uploads, for example https://api.example.com/uploads.
MEDIA_DIR=""
MEDIA_PUBLIC_URL=""
