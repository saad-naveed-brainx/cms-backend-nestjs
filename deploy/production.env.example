# cms-api on the live server (deploy/README.md). Copy to .env in this repo and fill the <…> values.
NODE_ENV=production
DATABASE_URL="postgresql://nodepress:<database password>@127.0.0.1:5432/nodepress"
API_PORT=4000

# Signs sign-in tokens. In production it must be 32 characters or more: openssl rand -hex 32
JWT_SECRET="<openssl rand -hex 32>"
JWT_EXPIRES_IN="7d"

# The admin's address: the only web page allowed to call the API from a browser.
CORS_ORIGINS="https://admin.nodepress.brainxdemo.com"

# After a publish, the API tells the website (inside the server) to forget that site's cached pages.
# The secret is shared with the website's .env.
WEB_REVALIDATE_URL="http://127.0.0.1:3000/api/revalidate"
REVALIDATE_SECRET="<openssl rand -hex 32, the same value in the website's .env>"

# Uploaded pictures, outside the code so a new deploy keeps them; back this folder up with the database.
MEDIA_DIR="/srv/nodepress/uploads"
MEDIA_PUBLIC_URL="https://api.nodepress.brainxdemo.com/uploads"
